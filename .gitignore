# ============================================
# .gitignore untuk proyek RNStudio1
# Stack: React Native 0.69 + TypeScript + Redux
# ============================================

# ---------- Node.js / Dependensi ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------- Output Build & Cache ----------
# Metro Bundler
.metro-health-check*
*.jsbundle

# Android
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/.cxx/
*.apk
*.ap_
*.dex
*.class
*.keystore
!debug.keystore
*.hprof

# iOS
ios/build/
ios/Pods/
ios/DerivedData/
*.ipa
*.dSYM.zip
*.dSYM
*.hmap
*.xcuserstate
xcuserdata/
*.xccheckout
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

# ---------- Testing & Coverage ----------
coverage/
*.lcov
.nyc_output/

# ---------- Cache Lainnya ----------
.eslintcache
*.tsbuildinfo
.cache/

# ---------- Environment & Secrets ----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.mobileprovision

# ---------- Ruby / CocoaPods ----------
vendor/bundle/
.bundle/
*.gem
Gemfile.lock

# ---------- Buck ----------
buck-out/
\.buckd/

# ---------- Fastlane ----------
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output

# ---------- File IDE / Editor ----------
# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
# JetBrains
.idea/
*.iml
*.ipr
*.iws
# Vim / Emacs
*.swp
*.swo
*~

# ---------- File OS ----------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
# Linux
.directory
.Trash-*

# ---------- File Sementara ----------
*.bak
*.tmp
*.old
